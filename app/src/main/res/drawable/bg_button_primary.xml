<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/gs_ripple">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0" android:startColor="@color/gs_accent" android:endColor="@color/gs_accent_end" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/gs_white" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</ripple>
