<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="6dp">

    <com.example.gsviewer.RatioFrameLayout
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cover"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/cover_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/cover_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#99FFFFFF"
            android:textSize="38sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/btn_more"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_more_btn"
            android:contentDescription="@string/cd_more"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/gs_white" />
    </com.example.gsviewer.RatioFrameLayout>

    <TextView
        android:id="@+id/name"
        style="@style/GS.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="10dp" />

    <TextView
        android:id="@+id/meta"
        style="@style/GS.Text.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp" />
</LinearLayout>
