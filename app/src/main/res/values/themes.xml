<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The whole app: dark, cinematic. YouTube pages inside the WebView follow it (dark mode). -->
    <style name="Theme.GSViewer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/gs_bg</item>
        <item name="android:statusBarColor">@color/gs_bg</item>
        <item name="android:navigationBarColor">@color/gs_bg</item>
        <item name="android:colorPrimary">@color/gs_surface</item>
        <item name="android:colorPrimaryDark">@color/gs_bg</item>
        <item name="android:colorAccent">@color/gs_accent</item>
        <item name="android:colorBackground">@color/gs_bg</item>
        <item name="android:colorControlHighlight">@color/gs_ripple</item>
        <item name="android:textColorPrimary">@color/gs_text</item>
        <item name="android:textColorSecondary">@color/gs_text_secondary</item>
        <item name="android:textColorHint">@color/gs_text_tertiary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowAnimationStyle">@style/GS.ActivityAnimation</item>
    </style>

    <!-- Bottom sheets (all dialogs of the app) -->
    <style name="GS.Sheet" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/gs_surface</item>
        <item name="android:colorAccent">@color/gs_accent</item>
        <item name="android:windowAnimationStyle">@style/GS.SheetAnimation</item>
    </style>

    <style name="GS.SheetAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/gs_sheet_in</item>
        <item name="android:windowExitAnimation">@anim/gs_sheet_out</item>
    </style>

    <style name="GS.ActivityAnimation" parent="android:Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/gs_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/gs_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/gs_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/gs_exit</item>
    </style>

    <!-- Text styles -->
    <style name="GS.Text.Title" parent="">
        <item name="android:textColor">@color/gs_text</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="GS.Text.Body" parent="">
        <item name="android:textColor">@color/gs_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="GS.Text.Meta" parent="">
        <item name="android:textColor">@color/gs_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
